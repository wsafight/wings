process AllocationFailures {
  record Marker { value: Int }
  state data: Bytes = replace_i64_be(fill_bytes(256, 0), 0, 7)

  on Touch(delta: Int) -> Int {
    let marker = Marker(read_i64_be(data, 0) + delta)
    data = replace_i64_be(data, 0, marker.value)
    marker.value
  }

  on Replace(length: Int) -> Int {
    data = fill_bytes(length, 9)
    bytes_len(data)
  }

  on Echo(input: Bytes) -> Int {
    data = input
    bytes_len(data)
  }

  on ReplyCandidate -> Bytes {
    data = fill_bytes(4096, 9)
    data
  }
}
