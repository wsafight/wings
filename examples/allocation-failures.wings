actor AllocationFailures {
  struct Marker { value: int }
  state data = bytes::fill(256, 0).set_i64(0, 7)

  on touch(delta: int) -> int {
    let marker = Marker(data.i64_at(0) + delta)
    data = data.set_i64(0, marker.value)
    marker.value
  }

  on replace(length: int) -> int {
    data = bytes::fill(length, 9)
    data.len()
  }

  on echo(input: bytes) -> int {
    data = input
    data.len()
  }

  on reply_candidate -> bytes {
    data = bytes::fill(4096, 9)
    data
  }
}
