process BeamCounter {
  state data: Bytes = fill_bytes(256, 0)

  on Configure(length: Int, initial: Int) -> Int {
    let empty = fill_bytes(length, 0)
    let identified = replace_i64_be(empty, 8, 1)
    data = replace_i64_be(identified, 0, initial)
    read_i64_be(data, 0)
  }

  on Apply(sequence: Int, operation: Int, delta: Int, reserved: Int) -> Int {
    let next = read_i64_be(data, 0) + delta
    data = replace_i64_be(data, 0, next)
    if operation == 2 { 1 / 0 } else { read_i64_be(data, 0) }
  }
}
