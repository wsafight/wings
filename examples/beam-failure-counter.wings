actor BeamFailureCounter {
  state data = bytes::fill(256, 0)

  on configure(length: int, initial: int, identity: int) -> int {
    let empty = bytes::fill(length, 0)
    let identified = empty.set_i64(8, identity)
    data = identified.set_i64(0, initial)
    data.i64_at(0)
  }

  on apply(sender: int, sequence: int, delta: int, operation: int) -> int {
    let offset = if sender == 1 { 16 } else { 24 }
    let checked = if sequence == data.i64_at(offset) + 1 { delta } else { 9223372036854775807 + sender }
    let counter = data.set_i64(0, data.i64_at(0) + checked)
    data = counter.set_i64(offset, sequence)
    if operation == 2 { 1 / 0 } else { data.i64_at(0) }
  }
}
