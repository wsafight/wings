process BeamFairness {
  fn ten(value: Int) -> Int {
    let first = value + 1
    let second = first + 1
    let third = second + 1
    let fourth = third + 1
    let fifth = fourth + 1
    let sixth = fifth + 1
    let seventh = sixth + 1
    let eighth = seventh + 1
    let ninth = eighth + 1
    ninth + 1
  }
  fn hundred(value: Int) -> Int {
    ten(ten(ten(ten(ten(ten(ten(ten(ten(ten(value))))))))))
  }
  fn thousand(value: Int) -> Int {
    hundred(hundred(hundred(hundred(hundred(hundred(hundred(hundred(hundred(hundred(value))))))))))
  }
  fn ten_thousand(value: Int) -> Int {
    thousand(thousand(thousand(thousand(thousand(thousand(thousand(thousand(thousand(thousand(value))))))))))
  }
  fn hundred_thousand(value: Int) -> Int {
    ten_thousand(ten_thousand(ten_thousand(ten_thousand(ten_thousand(ten_thousand(ten_thousand(ten_thousand(ten_thousand(ten_thousand(value))))))))))
  }
  fn million(value: Int) -> Int {
    hundred_thousand(hundred_thousand(hundred_thousand(hundred_thousand(hundred_thousand(hundred_thousand(hundred_thousand(hundred_thousand(hundred_thousand(hundred_thousand(value))))))))))
  }

  state data: Bytes = fill_bytes(256, 0)

  on Configure(identity: Int) -> Int {
    data = replace_i64_be(data, 8, identity)
    read_i64_be(data, 0)
  }

  on Pulse(sequence: Int, operation: Int, delta: Int, reserved: Int) -> Int {
    data = replace_i64_be(data, 0, read_i64_be(data, 0) + 1)
    read_i64_be(data, 0)
  }

  on Cpu(sequence: Int, operation: Int, delta: Int, reserved: Int) -> Int {
    let result = million(0)
    data = replace_i64_be(data, 0, read_i64_be(data, 0) + 1)
    result
  }
}
