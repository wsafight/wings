actor Branches {
  struct Boxed { value: int }
  state count = if true { 7 } else { 1 / 0 }
  on select(flag: bool, value: int) -> int {
    count = if flag { value } else { count }
    count
  }
  on nested(first: bool, second: bool) -> int {
    if first { if second { 11 } else { 22 } } else { if second { 33 } else { 44 } }
  }
  on guard(flag: bool) -> int {
    if flag { 17 } else { 1 / 0 }
  }
  on heap(flag: bool) -> int {
    let saved = Boxed(count)
    let selected = if flag { Boxed(11).value } else { Boxed(22).value }
    gc()
    saved.value + selected
  }
  on optional_heap(flag: bool) -> int {
    if flag { 9 } else { Boxed(4).value }
  }
  on unit(flag: bool) -> () {
    if flag { () } else { gc() }
  }
  on bool(flag: bool) -> bool {
    if flag { false } else { true }
  }
  on overflow(flag: bool) -> int {
    if flag { 9223372036854775807 + 1 } else { 9 }
  }
}
