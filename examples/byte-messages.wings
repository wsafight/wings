actor ByteMessages {
  struct Boxed { value: int }
  state saved = bytes::fill(8, 0)

  fn score(value: bytes) -> int {
    value.len() * 512 + if value.len() == 0 { 0 } else {
      value.at(0) + value.at(value.len() - 1)
    }
  }

  on start(length: int, value: int, fail: bool) -> int {
    let child = spawn()
    let data = bytes::fill(length, value)
    child ! store(data)
    saved = bytes::fill(8, 9)
    gc()
    if fail { 1 / 0 } else { score(data) }
  }

  on self_msg(length: int, value: int) -> int {
    let data = bytes::fill(length, value)
    self ! store(data)
    gc()
    score(data)
  }

  on ask(length: int, value: int, timeout: int) -> int {
    let child = spawn()
    let data = bytes::fill(length, value)
    let pending = child.ask(compute(data), timeout: timeout, then: completed)
    gc()
    score(data)
  }

  on mixed(length: int, value: int) -> int {
    let child = spawn()
    let first = bytes::fill(length, value)
    let second = bytes::fill(65536 - length, value + 1)
    child ! store_mixed(first, Boxed(7), [3, 5], second, true, bytes::fill(0, 0))
    gc()
    score(first)
  }

  on repeat(length: int) -> int {
    let child = spawn()
    let data = bytes::fill(length, 23)
    child ! store_pair(data, data)
    gc()
    score(data)
  }

  on store(value: bytes) { gc(); saved = value; gc() }

  on over -> int {
    let child = spawn()
    child ! store_pair(bytes::fill(65536, 17), bytes::fill(1, 19))
    0
  }

  on store_pair(first: bytes, second: bytes) {
    gc()
    saved = bytes::fill(8, 0).set_i64(0, score(first) + score(second))
    gc()
  }

  on store_mixed(first: bytes, record: Boxed, values: [int], second: bytes, flag: bool, empty: bytes) {
    gc()
    saved = bytes::fill(8, 0).set_i64(0, score(first) + score(second) + record.value
      + values.head() + values.tail().head() + if flag { 1 } else { 0 } + empty.len())
    gc()
  }

  on compute(value: bytes) -> int { gc(); saved = value; score(value) }

  on reply completed(id: req, status: int, value: int) {
    saved = bytes::fill(8, 0).set_i64(0, status * 1000000000 + value + 1)
    gc()
  }

  on read -> int { gc(); score(saved) }
  on result -> int { gc(); saved.i64_at(0) }
}
