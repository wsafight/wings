actor ChunkedGc {
  fn refresh(value: box<int>) -> box<int> {
    gc()
    box(value.get() + 1)
  }
  state value = box(7)
  on get -> int { value.get() }
  on sweep -> int {
    let outer = box(11)
    value = refresh(value)
    gc()
    outer.get() + value.get()
  }
  on allocate(limit: int) -> int {
    while value.get() < limit {
      value = box(value.get() + 1)
    }
    value.get()
  }
}
