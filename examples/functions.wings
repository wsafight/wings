actor Functions {
  fn twice(value: int) -> int { value + value }
  fn fresh(value: int) -> box<int> { box(value) }
  fn next(value: box<int>) -> box<int> {
    gc()
    fresh(value.get() + 1)
  }
  fn choose(flag: bool, value: box<int>) -> box<int> {
    if flag { next(value) } else { value }
  }
  fn count_value(first: box<int>, second: box<int>) -> int {
    gc()
    first.get() * 10 + second.get()
  }
  fn unchanged(value: box<int>) -> box<int> { value }
  fn fail(value: box<int>) -> int {
    gc()
    value.get() / 0
  }
  state value = fresh(twice(0))
  on get -> int { value.get() }
  on count(limit: int) -> int {
    while value.get() < limit {
      value = next(value)
    }
    value.get()
  }
  on choose(flag: bool) -> int {
    value = choose(flag, value)
    value.get()
  }
  on order -> int { count_value(fresh(1), fresh(2)) }
  on once -> int { count_value(unchanged(fresh(3)), unchanged(value)) }
  on first_failure -> int {
    count_value(fresh(1 / 0), fresh(9223372036854775807 + 1))
  }
  on second_failure -> int {
    count_value(fresh(9223372036854775807 + 1), fresh(1 / 0))
  }
  on fail -> int {
    value = next(value)
    fail(value)
  }
}
