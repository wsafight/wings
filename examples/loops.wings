process Loops {
  state count: Int = 0
  on Get -> Int { count }
  on Count(limit: Int) -> Int {
    while count < limit {
      count = count + 1
    }
    count
  }
  on Heap(limit: Int) -> Int {
    let saved = record_int(3)
    while count < limit {
      let temporary = record_int(count)
      collect()
      count = read_int(temporary) + read_int(saved)
    }
    count
  }
  on Nested(limit: Int) -> Int {
    while count < limit {
      let next = count + 2
      while count < next {
        count = count + 1
      }
    }
    count
  }
  on NestedHeap(limit: Int) -> Int {
    let saved = record_int(3)
    while count < limit {
      let next = count + 2
      while count < next {
        let temporary = record_int(count)
        let selected = if count < limit { read_int(saved) } else { read_int(temporary) }
        collect()
        count = read_int(temporary) + if selected == 3 { 1 } else { 2 }
      }
    }
    count
  }
  on Forever {
    while true {}
  }
  on BranchHeap(limit: Int) -> Int {
    let saved = record_int(3)
    while count < limit {
      let selected = if count < 6 { record_int(1) } else { saved }
      collect()
      count = count + read_int(selected)
    }
    count
  }
  on Fail(limit: Int) -> Int {
    while count < limit {
      count = count + 1
    }
    1 / 0
  }
}
