actor Loops {
  state count = 0
  on get -> int { count }
  on count(limit: int) -> int {
    while count < limit {
      count = count + 1
    }
    count
  }
  on heap(limit: int) -> int {
    let saved = box(3)
    while count < limit {
      let temporary = box(count)
      gc()
      count = temporary.get() + saved.get()
    }
    count
  }
  on nested(limit: int) -> int {
    while count < limit {
      let next = count + 2
      while count < next {
        count = count + 1
      }
    }
    count
  }
  on nested_heap(limit: int) -> int {
    let saved = box(3)
    while count < limit {
      let next = count + 2
      while count < next {
        let temporary = box(count)
        let selected = if count < limit { saved.get() } else { temporary.get() }
        gc()
        count = temporary.get() + if selected == 3 { 1 } else { 2 }
      }
    }
    count
  }
  on forever {
    while true {}
  }
  on branch_heap(limit: int) -> int {
    let saved = box(3)
    while count < limit {
      let selected = if count < 6 { box(1) } else { saved }
      gc()
      count = count + selected.get()
    }
    count
  }
  on fail(limit: int) -> int {
    while count < limit {
      count = count + 1
    }
    1 / 0
  }
}
