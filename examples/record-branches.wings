actor RecordBranches {
  state value = if true { box(7) } else { box(1 / 0) }
  on get -> int { value.get() }
  on replace(flag: bool, next: int) -> int {
    value = if flag { box(next) } else { value }
    gc()
    value.get()
  }
  on nested(first: bool, second: bool, next: int) -> int {
    value = if first {
      if second { box(next) } else { value }
    } else {
      if second { value } else { box(next + 1) }
    }
    gc()
    value.get()
  }
  on local(flag: bool, next: int) -> int {
    let saved = if flag { box(next) } else { box(next + 1) }
    gc()
    saved.get() + value.get()
  }
  on discard(flag: bool) -> int {
    if flag { box(11) } else { box(13) };
    gc()
    value.get()
  }
  on fail(flag: bool) -> int {
    value = if flag { box(99) } else { value }
    gc()
    1 / 0
  }
}
