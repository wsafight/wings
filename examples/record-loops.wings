actor RecordLoops {
  state value = box(0)
  on get -> int { value.get() }
  on count(limit: int) -> int {
    while value.get() < limit {
      value = box(value.get() + 1)
      gc()
    }
    value.get()
  }
  on preserve(flag: bool, next: int) -> int {
    value = box(next)
    while flag {
      value = box(value.get() + 1)
    }
    gc()
    value.get()
  }
  on advance(limit: int, next: int) -> int {
    value = box(next)
    while value.get() < limit {
      value = box(value.get() + 1)
      gc()
    }
    value.get()
  }
  on retain(limit: int) -> int {
    while value.get() < limit {
      let previous = value
      value = box(value.get() + 1)
      gc()
      previous.get();
    }
    value.get()
  }
  on sequential(first: bool, second: bool, next: int) -> int {
    let left = if first { box(next) } else { box(next + 1) }
    let right = if second { left } else { box(next + 2) }
    gc()
    left.get() + 10 * right.get()
  }
  on backedges(limit: int, next: int) -> int {
    let saved = box(next)
    value = box(0)
    while value.get() < limit {
      let until = value.get() + 2
      let outer = if saved.get() < 0 { box(0) } else { saved }
      while value.get() < until {
        let inner = if value.get() < until - 1 { outer } else { box(next + 1) }
        value = box(value.get() + 1)
        gc()
        inner.get();
        outer.get();
      }
      saved.get();
    }
    gc()
    value.get() + saved.get()
  }
  on zero_exit(flag: bool, next: int) -> int {
    let saved = box(next)
    while flag {
      let selected = if value.get() < 0 { saved } else { box(next + 1) }
      value = selected
      gc()
      saved.get();
    }
    gc()
    saved.get() + value.get()
  }
  on empty_branches(flag: bool, next: int) -> int {
    let saved = box(next)
    value = if flag { saved } else { value }
    gc()
    value.get()
  }
  on nested(limit: int) -> int {
    let saved = value
    while value.get() < limit {
      let until = value.get() + 2
      while value.get() < until {
        value = if value.get() < limit {
          box(value.get() + 1)
        } else { box(value.get() + 2) }
        gc()
      }
    }
    value.get() + saved.get()
  }
  on fail(limit: int) -> int {
    while value.get() < limit {
      value = box(value.get() + 1)
      gc()
    }
    1 / 0
  }
}
