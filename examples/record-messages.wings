actor RecordMessages {
  state saved = box(0)

  on start(value: int, fail: bool) -> int {
    let child = spawn()
    let message = box(value)
    child ! store(message)
    gc()
    if fail { 1 / 0 } else { message.get() }
  }

  on self_msg(value: int) -> int {
    let message = box(value)
    self ! store(message)
    gc()
    message.get()
  }

  on ask(value: int) -> int {
    let child = spawn()
    let id = child.ask(compute(box(value)), timeout: 60000, then: completed)
    saved.get()
  }

  on pair(value: int) -> int {
    let child = spawn()
    child ! store_pair(box(value), true, box(value + 1))
    value
  }

  on store(value: box<int>) {
    gc()
    saved = value
    gc()
  }

  on store_pair(first: box<int>, flag: bool, second: box<int>) {
    gc()
    saved = box(first.get() + if flag { second.get() } else { 0 })
    gc()
  }

  on compute(value: box<int>) -> int {
    gc()
    value.get() + 1
  }

  on reply completed(id: req, status: int, value: int) {
    saved = box(status * 100 + value)
  }

  on read -> int { gc(); saved.get() }
}
