process RecordMessages {
  state saved: RecordInt = record_int(0)

  on Start(value: Int, fail: Bool) -> Int {
    let child = spawn_self()
    let message = record_int(value)
    send(child, Store, message)
    collect()
    if fail { 1 / 0 } else { read_int(message) }
  }

  on Self(value: Int) -> Int {
    let message = record_int(value)
    send_self(Store, message)
    collect()
    read_int(message)
  }

  on Ask(value: Int) -> Int {
    let child = spawn_self()
    let id = request(child, Compute, Completed, 60000, record_int(value))
    read_int(saved)
  }

  on Pair(value: Int) -> Int {
    let child = spawn_self()
    send(child, StorePair, record_int(value), true, record_int(value + 1))
    value
  }

  on Store(value: RecordInt) {
    collect()
    saved = value
    collect()
  }

  on StorePair(first: RecordInt, flag: Bool, second: RecordInt) {
    collect()
    saved = record_int(read_int(first) + if flag { read_int(second) } else { 0 })
    collect()
  }

  on Compute(value: RecordInt) -> Int {
    collect()
    read_int(value) + 1
  }

  on Completed(id: RequestId, status: Int, value: Int) {
    saved = record_int(status * 100 + value)
  }

  on Read -> Int { collect(); read_int(saved) }
}
