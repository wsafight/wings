actor RecordReplies {
  state count = 0

  fn make(value: int) -> box<int> {
    let result = box(value)
    gc()
    result
  }

  on value(value: int) -> box<int> {
    let result = make(value)
    count = count + 1
    gc()
    result
  }

  on echo(value: box<int>) -> box<int> {
    gc()
    count = value.get()
    value
  }

  on current -> box<int> { make(count) }
  on fail -> box<int> {
    count = 99
    let failed = 1 / 0
    make(count)
  }

  on start(value: int, timeout: int, cancel: bool, fail: bool, same: bool) -> int {
    let target = if same { self } else { spawn() }
    let pending = if fail {
      target.ask(fail, timeout: timeout, then: done)
    } else {
      target.ask(value(value), timeout: timeout, then: done)
    }
    if cancel { pending.cancel() }
    count = 9
    count
  }

  on reply done(id: req, status: int, value: box<int>) {
    gc()
    count = status * 1000 + value.get()
    gc()
    self ! add(10000)
  }

  on add(value: int) { count = count + value }
  on read -> int { count }
}
