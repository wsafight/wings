actor RecordReplyState {
  state data = box(5)

  on current -> box<int> { gc(); data }
  on put(value: int) -> box<int> { data = box(value); gc(); data }
  on read -> int { gc(); data.get() }

  on start_import_fail -> int {
    let child = spawn()
    let pending = child.ask(current, timeout: 60000, then: done)
    9
  }

  on reply done(id: req, status: int, value: box<int>) {
    gc()
    data = value
    gc()
  }
}
