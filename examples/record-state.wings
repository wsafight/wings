actor RecordState {
  state current = box(7)

  on get -> int {
    gc()
    current.get()
  }

  on set(value: int) -> int {
    current = box(value)
    gc()
    current.get()
  }

  on replace(value: int) {
    current = box(value)
    gc()
  }

  on fail -> int {
    current = box(99)
    gc()
    1 / 0
  }

  on conditional(flag: bool) -> int {
    let selected = if flag { box(11).get() } else { current.get() }
    gc()
    current.get() + selected
  }
}
