actor Records {
  state count = 0

  on work(value: int) -> int {
    let first: box<int> = box(value)
    box(value + 1)
    box(value + 2)
    gc()
    count = first.get()
    count
  }

  on get -> int { count }

  on fail -> int {
    let candidate = box(99)
    count = candidate.get()
    1 / 0
  }

  on full -> int {
    let first = box(1)
    let second = box(2)
    let third = box(3)
    first.get() + second.get() + third.get()
  }
}
