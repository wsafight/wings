actor SchedulerDemo {
  state saved: [int] = []

  on begin(value: int) -> int {
    let child = spawn()
    let items = [value + 1, value + 2]
    child ! store(items, box(value))
    gc()
    let id = child.ask(compute([3]), timeout: 60000, then: completed)
    value
  }

  on store(items: [int], record: box<int>) {
    gc()
    saved = [items.head() + items.tail().head() + record.get()]
    gc()
  }

  on compute(items: [int]) -> int {
    gc()
    saved.head() + items.head()
  }

  on reply completed(id: req, status: int, value: int) {
    saved = [if status == 0 { value } else { -100 - status }]
  }

  on read -> int { gc(); if saved.is_empty() { -1 } else { saved.head() } }
  on fail -> int { saved = [99, ..saved]; 1 / 0 }
}
