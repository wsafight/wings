process StringReplies {
  state data: Bytes = fill_bytes(0, 0)

  on Make(length: Int) -> String {
    data = fill_bytes(length, 97)
    collect()
    string_from_bytes(data)
  }
  on Echo(input: String) -> String { collect(); data = string_bytes(input); collect(); input }
  on Current -> String { collect(); string_from_bytes(data) }
  on Candidate -> String { let old = string_from_bytes(data); data = fill_bytes(1, 77); collect(); old }
  on Fail -> String { data = fill_bytes(1, 99); let failed = 1 / 0; string_from_bytes(data) }
  on Clear { data = fill_bytes(0, 0); collect() }
  on Marker -> Int { if bytes_len(data) == 0 { -1 } else { byte_at(data, 0) } }
  on Unicode -> String { "中😀\0\n\r\t\\\"" }

  on Start(length: Int, timeout: Int, cancel: Bool, fail: Bool, same: Bool) -> Int {
    let target = if same { self_pid() } else { spawn_self() }
    let pending = if fail {
      request(target, Fail, Done, timeout)
    } else {
      request(target, Make, Done, timeout, length)
    }
    if cancel { cancel_request(pending) } else { () }
    data = fill_bytes(1, 9)
    9
  }
  on Done(id: RequestId, status: Int, result: String) {
    collect()
    let bytes = string_bytes(result)
    let length = bytes_len(bytes)
    let edges = if length == 0 { 0 } else { byte_at(bytes, 0) + byte_at(bytes, length - 1) }
    data = replace_i64_be(replace_i64_be(replace_i64_be(fill_bytes(24, 0), 0, 9), 8, length), 16, edges)
    collect()
    send_self(Mark, status)
  }
  on Mark(status: Int) { data = replace_i64_be(data, 0, status) }
  on CompletedStatus -> Int { read_i64_be(data, 0) }
  on CompletedLength -> Int { read_i64_be(data, 8) }
  on CompletedEdges -> Int { read_i64_be(data, 16) }
  on Completed -> Int { if bytes_len(data) == 24 { read_i64_be(data, 0) } else { 9 } }

  on Initial -> String { string_from_bytes(data) }
  on StartImportFail -> Int {
    let target = spawn_self()
    let pending = request(target, Initial, Done, 60000)
    9
  }
}
