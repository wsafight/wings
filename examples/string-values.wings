process Text {
  state text: String = "";

  fn copy(value: String) -> String {
    let result = string_from_bytes(string_bytes(value));
    collect();
    result
  }

  on Fill(length: Int) -> Int {
    text = string_from_bytes(fill_bytes(length, 97));
    string_len(text)
  }

  on Read -> Int { string_len(text) }

  on ByteLength -> Int { bytes_len(string_bytes(text)) }

  on Store(value: String) { collect(); text = value; collect(); }

  on Echo(value: String) -> Bytes { collect(); text = value; string_bytes(value) }

  on Mixed(value: String, data: Bytes, record: RecordInt, values: IntList, empty: String) -> Int {
    collect();
    text = value;
    string_len(value) * 1000000 + bytes_len(string_bytes(value)) * 1000 + bytes_len(data) +
      read_int(record) + head_int(values) + string_len(empty)
  }

  on SendText(length: Int) -> Int {
    let child = spawn_self();
    let value = string_from_bytes(fill_bytes(length, 97));
    send(child, Store, value);
    collect();
    string_len(value)
  }

  on SelfText(value: String) { send_self(Store, value); collect(); }

  on AskText(value: String, timeout: Int) -> Int {
    let child = spawn_self();
    let pending = request(child, CountText, TextDone, timeout, value);
    collect();
    string_len(value)
  }

  on CountText(value: String) -> Int { collect(); text = value; string_len(value) }
  on TextDone(id: RequestId, status: Int, value: Int) {
    text = string_from_bytes(fill_bytes(if status == 0 { value } else { 0 }, 97));
  }

  on OverText { let value = string_from_bytes(fill_bytes(32769, 97)); send_self(PairText, value, value); }
  on PairText(first: String, second: String) { text = concat_strings(first, second); }

  on SendThenFail { let child = spawn_self(); send(child, Store, "published"); text = "candidate"; 1 / 0; }

  on Unicode -> Int {
    text = concat_strings("中", "😀");
    collect();
    string_len(text) * 100 + bytes_len(string_bytes(copy(text)))
  }

  on Copy -> Int {
    let next = copy(text);
    collect();
    text = next;
    string_len(text)
  }

  on Choose(flag: Bool) -> Int {
    text = if flag { copy(text) } else { string_from_bytes(fill_bytes(0, 0)) };
    string_len(text)
  }

  on Grow(limit: Int) -> Int {
    text = string_from_bytes(fill_bytes(0, 0));
    while string_len(text) < limit {
      text = concat_strings(text, string_from_bytes(fill_bytes(1, 97)));
      collect();
    }
    string_len(text)
  }

  on Double -> Int {
    text = concat_strings(text, text);
    string_len(text)
  }

  on Invalid -> Int {
    text = string_from_bytes(fill_bytes(4, 97));
    text = string_from_bytes(fill_bytes(1, 255));
    string_len(text)
  }

  on Clear -> Unit {
    text = string_from_bytes(fill_bytes(0, 0));
    collect();
  }

  on Sweep -> Unit { collect(); }

  fn suffix(value: String) -> String { concat_strings(value, "\0\n\r\t\\\"") }

  on Literal -> Int {
    text = suffix("中😀");
    collect();
    let data = string_bytes(text);
    string_len(text) * 100 + bytes_len(data)
  }
}
