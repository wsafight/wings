process Text {
  state text: String = "";

  fn copy(value: String) -> String {
    let result = string_from_bytes(string_bytes(value));
    collect();
    result
  }

  on Fill(length: Int) -> Int {
    text = string_from_bytes(fill_bytes(length, 97));
    string_len(text)
  }

  on Read -> Int { string_len(text) }

  on ByteLength -> Int { bytes_len(string_bytes(text)) }

  on Unicode -> Int {
    text = concat_strings("中", "😀");
    collect();
    string_len(text) * 100 + bytes_len(string_bytes(copy(text)))
  }

  on Copy -> Int {
    let next = copy(text);
    collect();
    text = next;
    string_len(text)
  }

  on Choose(flag: Bool) -> Int {
    text = if flag { copy(text) } else { string_from_bytes(fill_bytes(0, 0)) };
    string_len(text)
  }

  on Grow(limit: Int) -> Int {
    text = string_from_bytes(fill_bytes(0, 0));
    while string_len(text) < limit {
      text = concat_strings(text, string_from_bytes(fill_bytes(1, 97)));
      collect();
    }
    string_len(text)
  }

  on Double -> Int {
    text = concat_strings(text, text);
    string_len(text)
  }

  on Invalid -> Int {
    text = string_from_bytes(fill_bytes(4, 97));
    text = string_from_bytes(fill_bytes(1, 255));
    string_len(text)
  }

  on Clear -> Unit {
    text = string_from_bytes(fill_bytes(0, 0));
    collect();
  }

  on Sweep -> Unit { collect(); }

  fn suffix(value: String) -> String { concat_strings(value, "\0\n\r\t\\\"") }

  on Literal -> Int {
    text = suffix("中😀");
    collect();
    let data = string_bytes(text);
    string_len(text) * 100 + bytes_len(data)
  }
}
