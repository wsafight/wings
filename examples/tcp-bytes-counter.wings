process TcpBytesCounter {
  state data: Bytes = fill_bytes(256, 0)

  on Configure(length: Int) -> Int {
    let empty = fill_bytes(length, 0)
    data = replace_i64_be(empty, 8, 1)
    read_i64_be(data, 0)
  }

  on Apply(delta: Int, fail: Bool) -> Int {
    let next = read_i64_be(data, 0) + delta
    data = replace_i64_be(data, 0, next)
    if fail { 1 / 0 } else { read_i64_be(data, 0) }
  }

  on Read -> Bytes {
    data
  }
}
