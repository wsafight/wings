process TypedIngress {
  state saved: Int = 0

  on Store(text: String, blob: Bytes, numbers: IntList, item: RecordInt, flag: Bool, unit: Unit) {
    collect()
    saved = string_len(text) * 1000000 + bytes_len(blob) + read_int(item) +
      if is_empty_ints(numbers) { 0 } else { head_int(numbers) } +
      if flag { 1 } else { 0 }
    collect()
  }

  on Compute(text: String, blob: Bytes, numbers: IntList, item: RecordInt, flag: Bool, unit: Unit) -> Int {
    collect()
    saved = string_len(text) * 1000000 + bytes_len(blob) + read_int(item) +
      if is_empty_ints(numbers) { 0 } else { head_int(numbers) } +
      if flag { 1 } else { 0 }
    collect()
    saved
  }

  on Get -> Int { saved }
}
