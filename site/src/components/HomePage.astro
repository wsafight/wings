const sampleCodeEn = `struct Command { session_id: int, prompt: str }
struct Reply   { session_id: int, turn: int, output: str }

actor Worker {
  state turns = 0

  on step(cmd: Command) -> Reply {
    turns += 1
    Reply {
      session_id: cmd.session_id,
      turn: turns,
      output: f"s{cmd.session_id}#{turns}:{cmd.prompt}",
    }
  }
}

actor Supervisor {
  state worker: pid?<Worker> = null
  state mon_id = 0
  state restarts = 0

  on boot -> bool {
    if worker.is_null() {
      let child = spawn(Worker)
      worker = child
      mon_id = monitor(child, on_down)
      let _t = send_after(1000, tick(1))
    }
    true
  }

  on tick(n: int) { /* periodic heartbeat */ }

  on on_down(id: int, reason: int) {
    if id == mon_id {
      restarts += 1
      let next = spawn(Worker)
      worker = next
      mon_id = monitor(next, on_down)
    }
  }
}`;

const sampleCodeZh = sampleCodeEn.replace('/* periodic heartbeat */', '/* 周期自定时心跳 */');
const sampleCode = locale === 'zh' ? sampleCodeZh : sampleCodeEn;

const cliCodeEn = `# 1. Static type, state & protocol verification
$ wings-compile check examples/session-service.wings

# 2. Emit native AOT bundle (Cranelift 0.118 + ShadowFrame GC roots)
$ wings-compile build-app examples/session-service.wings -o target/session-bundle

# 3. Launch preemptive multi-worker HTTP JSON-RPC server
$ wings-vm serve --trusted target/session-bundle --workers 4 --http 127.0.0.1:8080

# 4. Dispatch typed actor message & inspect health
$ curl -s http://127.0.0.1:8080/healthz
{"ok":true,"status":"ready","workers":4}`;

