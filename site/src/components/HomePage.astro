  <script is:inline>
    (() => {
      const tabs = Array.from(document.querySelectorAll('[data-hero-tab]'));
      const panes = Array.from(document.querySelectorAll('[data-hero-pane]'));
      const copyBtn = document.getElementById('hero-copy-btn');
      if (!tabs.length || !panes.length) return;

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-hero-tab');
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          panes.forEach((p) => {
            p.hidden = p.getAttribute('data-hero-pane') !== target;
          });
          if (copyBtn) {
            copyBtn.setAttribute('data-copy', tab.getAttribute('data-raw-code') || '');
          }
        });
      });
    })();
  </script>
