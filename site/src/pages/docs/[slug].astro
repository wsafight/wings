---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getDocItems, getDocMap } from '../../lib/docs';

export async function getStaticPaths() {
  const docMap = getDocMap('en');
  const entries = await getCollection('docsEn');
  return entries
    .filter((entry) => docMap.has(entry.id))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const docItems = getDocItems('en');
const docMap = getDocMap('en');
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const meta = docMap.get(entry.id)!;
const currentIndex = docItems.findIndex((item) => item.slug === entry.id);
const prevDoc = currentIndex > 0 ? docItems[currentIndex - 1] : undefined;
const nextDoc =
  currentIndex >= 0 && currentIndex < docItems.length - 1
    ? docItems[currentIndex + 1]
    : undefined;
---

<DocsLayout
  locale="en"
  title={meta.title}
  summary={meta.summary}
  group={meta.group}
  currentSlug={meta.slug}
  sourceFile={meta.sourceFile}
  headings={headings}
  prevDoc={prevDoc}
  nextDoc={nextDoc}
>
  <Content />
</DocsLayout>
